[Unit]
Description=SONiC privileged Redis display service
Requires=database.service
After=database.service

[Service]
Type=simple
User=redis
Group=redis
RuntimeDirectory=sonic-redis-display
RuntimeDirectoryMode=0755
ExecStart=/usr/local/bin/sonic-redis-displayd
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
